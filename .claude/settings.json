{
  "permissions": {
    "deny": [
      "Read(**/Recoil.exe)", "Read(**/recoil.exe)", "Read(**/RECOIL.EXE)",
      "Read(**/recoil3dfx.exe)", "Read(**/RECOIL3DFX.EXE)",
      "Bash(objdump:*)", "Bash(llvm-objdump:*)", "Bash(strings:*)",
      "Bash(xxd:*)", "Bash(hexdump:*)", "Bash(od:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-original-binaries.sh" }
        ]
      }
    ]
  }
}
