# ---> Rust
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# This workspace produces an executable, so Cargo.lock is committed.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ---> Extracted game assets
# NEVER commit game data: no textures, models, audio, level files, and no test
# fixtures carved out of them. The engine reads these from a user-supplied
# Recoil install at runtime.
/extracted/
*.zbd
*.zmap
# Raw install and CD files, should a copy land in the tree. Not `*.wav` or
# `*.ttf`: our own sounds and fonts may use those.
*.[eE][xX][eE]
*.[dD][lL][lL]
*.[fF][lL][tT]
*.[gG][iI][fF]
*.[aA][vV][iI]
*.[iI][sS][oO]
*.[pP][dD][fF]
[eE][uU][rR][oO][sS][tT][iI].[tT][tT][fF]

# The extraction cache (mech3ax output: JSON, PNG, WAV) is derived game data.
# The suffixes are the cache layout (DESIGN §5.1); the asset loaders key on
# them.
/cache/
*.gamez.zip
*.tex.zip
*.anim.zip
*.rdr.zip
*.snd.zip
*.zmap.json

# ---> Operating system clutter
# Written by the desktop, not by us: kept out so a commit from any platform
# carries only the work.
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory
.Trash-*
.fuse_hidden*
.nfs*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ---> Observation tooling (tools/observe)
# Python caches and virtual environments.
__pycache__/
*.py[cod]
.venv/
venv/
# Evidence from the original game (recordings, marks files, frame grabs and
# measurements from them) lives in $OBFT_EVIDENCE_DIR, outside the
# repository; the tools refuse it here and entries cite it by SHA-256. These
# catch a stray copy: a scratch directory, a marks CSV beside the session
# files (their .ots proofs are committed), a recording or frame grabs.
/tools/observe/scratch/
/docs/observations/sessions/*.csv
*.[mM][kK][vV]
*.[mM][pP]4
*.[mM][oO][vV]
*.[fF][lL][vV]
*.[wW][eE][bB][mM]
*.grabs/

# Claude Code, per user
.claude/settings.local.json
